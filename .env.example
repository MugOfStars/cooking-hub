# Copy to .env and adjust: `cp .env.example .env`
# This single file is read by docker-compose (Postgres container) and the backend.
# These defaults are for local development only. Never reuse them anywhere real.

POSTGRES_USER=cooking_hub
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cooking_hub
POSTGRES_PORT=5432

# SQLAlchemy URL using the psycopg (v3) driver. Must match the values above.
DATABASE_URL=postgresql+psycopg://cooking_hub:change-me-locally@localhost:5432/cooking_hub
