# Copy to .env and adjust: `cp .env.example .env`
# This single file is read by docker-compose (Postgres container) and the backend.
# These defaults are for local development only. Never reuse them anywhere real.

POSTGRES_USER=cooking_hub
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=cooking_hub
POSTGRES_PORT=5432

# SQLAlchemy URL using the psycopg (v3) driver. Must match the values above.
DATABASE_URL=postgresql+psycopg://cooking_hub:change-me-locally@localhost:5432/cooking_hub

# Auth, local dev only. The password for this hash is "cooking".
# Make a real one with `uv run python -m app.hash_password` (in backend/).
# Keep the single quotes: the hash contains $, which docker-compose would otherwise expand.
AUTH_ENABLED=true
AUTH_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=4$+JJ7J2983znX9aus11XG2A$2O9tYmsUDips4IcdtPizupLIkKcjblyu+xXlUJYAPSI'
SESSION_SECRET=local-dev-session-secret-not-for-production
# Local dev runs over plain http, where browsers may not send a Secure cookie back.
COOKIE_SECURE=false
